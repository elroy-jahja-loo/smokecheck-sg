{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm run check:dependencies && npm ci",
  "crons": [
    {
      "path": "/api/internal/cron/refresh-onemap-token",
      "schedule": "0 0 */2 * *"
    }
  ],
  "routes": [
    { "src": "/api/rag/query", "methods": ["POST"], "mitigate": { "action": "challenge" } }
  ]
}
