# SmokeCheck SG local environment template
# Copy this file to `.env.local` for local testing.
# Do not commit `.env.local` or real secrets.

# App / deployment
NEXT_PUBLIC_APP_URL=http://localhost:3000
SMOKECHECK_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Mock officer login is local/preview-only and is always disabled in production.

# ---------------------------------------------------------------------------
# OneMap integration (Singapore Land Authority)
# Docs: https://www.onemap.gov.sg (requires SLA developer account)
# Auth: token-based, expires every 3 days (72h). Auto-refreshed 6h before expiry.
# Rate limit: 250 requests/minute per endpoint across all IPs.
# Never add NEXT_PUBLIC_ONEMAP_* values; browser code must call SmokeCheck API routes only.
# To refresh: POST https://www.onemap.gov.sg/api/auth/post/getToken with {email, password}
#   or set ONEMAP_EMAIL + ONEMAP_EMAIL_PASSWORD and the service auto-refreshes.
# ---------------------------------------------------------------------------
ONEMAP_API_BASE_URL=https://www.onemap.gov.sg
ONEMAP_API_TOKEN=
ONEMAP_TOKEN_EXPIRES_AT=
ONEMAP_EMAIL=
ONEMAP_EMAIL_PASSWORD=

# ---------------------------------------------------------------------------
# Data.gov.sg integration (GovTech)
# Docs: https://guide.data.gov.sg/developer-guide/api-overview/api-rate-limits
# Rate limits reset every 10 seconds:
#   | Endpoint           | No Key | Dev Key | Prod Key |
#   |--------------------|--------|---------|----------|
#   | v2 Realtime API    | 6      | 12      | 30       |
#   | Datastore Search   | 4      | 8       | 20       |
#   | Dataset Downloads  | 2      | 4       | 10       |
# Auth: x-api-key header. Register at https://data.gov.sg → Login → Create API Key.
# Without a key: public access works for testing but has the lowest limits.
# With a key: you get higher limits and priority support.
# ---------------------------------------------------------------------------
DATAGOV_API_BASE_URL=https://api-open.data.gov.sg
DATAGOV_API_KEY=
DATAGOV_DSA_DATASET_ID=d_d0fa8f07ef80ab23feaa3b870323bf27
DATAGOV_NSZ_DATASET_ID=d_491641889c8add4c7835721bd72aa84a
DATAGOV_NPARKS_NO_SMOKING_DATASET_ID=d_3c8343c1efaeb05d4d1dbcdd0f599077

# Database, future Postgres/PostGIS/pgvector storage.
# Supabase/Neon are suitable free-tier options for portfolio use.
USE_POSTGIS_DATA=false
POSTGIS_DATABASE_URL=
POSTGIS_POOL_SIZE=1
POSTGIS_SSL_CA=
PGVECTOR_DATABASE_URL=

# Redis-compatible cache/rate-limit backend, future replacement for in-memory adapter.
# Upstash Redis is a suitable free-tier option.
REDIS_URL=
REDIS_TOKEN=

# Kafka-compatible queue/event backend, future replacement for in-memory queue adapter.
# Upstash Kafka/QStash or another managed provider can be used for portfolio scale.
KAFKA_BROKERS=
KAFKA_USERNAME=
KAFKA_PASSWORD=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_PUBLISH_DESTINATION_URL=http://localhost:3000/api/queue/events

# App-level bot verification for high-risk endpoints.
# 2026 guidance: combine platform WAF/Bot controls with server-side Turnstile token verification.
# BOT_PROTECTION_MODE: "off" (default local) or "turnstile".
BOT_PROTECTION_MODE=off
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional host allow-list for Siteverify hostname matching.
BOT_PROTECTION_ALLOWED_HOSTNAMES=
# Optional test-only bypass token for local/dev automated tests (never set in production).
BOT_PROTECTION_TEST_BYPASS_TOKEN=
# Optional timeout override for Siteverify calls.
TURNSTILE_VERIFY_TIMEOUT_MS=3000

# Object storage for immutable source snapshots, generated vector tiles, and future placeholders.
# Cloudflare R2, Supabase Storage, or S3-compatible storage can be used.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=smokecheck-source-snapshots
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
LOCAL_SNAPSHOT_STORAGE_DIR=.local/smokecheck-source-snapshots

# Vector tile output and map consumption.
# Keep SMOKECHECK_VECTOR_TILE_MODE=viewport unless manifest and tile endpoint are ready.
SMOKECHECK_VECTOR_TILE_MODE=viewport
VECTOR_TILE_BASE_URL=
VECTOR_TILE_MANIFEST_PATH=.local/vector-tiles/manifest.json
SMOKECHECK_GEOJSON_SOURCE=data/generated/map-features.geojson
SMOKECHECK_TILE_OUTPUT_DIR=.local/vector-tiles
SMOKECHECK_TILE_MIN_ZOOM=10
SMOKECHECK_TILE_MAX_ZOOM=16

# Protected local/manual Data.gov.sg sync trigger.
# Use a generated secret only in local/Vercel env; never commit the real value.
DATAGOV_SYNC_INTERNAL_SECRET=
CRON_SECRET=
WORKER_INTERNAL_SECRET=

# FormSG-style handoff placeholder.
# Use only an authorised form/workflow URL. Do not clone FormSG.
FORMSG_HANDOFF_URL=

# Auth, future OIDC/MockPass-style local development.
# Keep blank until you choose a real auth provider/dev mock.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Observability, future OpenTelemetry exporter.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Sentry error monitoring and performance tracing.
# SENTRY_DSN is used by server/edge SDKs; NEXT_PUBLIC_SENTRY_DSN is the browser SDK.
# Both use the same DSN value for the javascript-nextjs project at sentry.io.
# For production, set these in Vercel environment variables, not in .env.local.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Sentry build-time auth token for source map uploads.
# Generate at: Sentry → Settings → Auth Tokens → project:releases scope.
# Set this in CI/CD or Vercel env vars. Never commit the plain text value.
# The .env.sentry-build-plugin file (gitignored) is a dev convenience only.
SENTRY_AUTH_TOKEN=

# Sentry environment override. Defaults to NODE_ENV.
# Use "staging" or "preview" for non-production deployments.
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
